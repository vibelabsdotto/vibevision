# VibeVision env (example). Copy to .env and fill in.
# Local dev uses defaults below; production sets these per app in Coolify.

# Web → API base URL (client + SSR). Local default: http://localhost:3101.
NEXT_PUBLIC_API_URL=http://localhost:3101
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# API (backend/.env or Coolify env). 32+ random bytes:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
DATABASE_PATH=./backend/data/vibevision.sqlite
