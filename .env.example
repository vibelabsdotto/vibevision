# Deployment env (example)
# Copy to .env and fill in.

# PocketBase base URL the Next.js app talks to
PB_URL=http://127.0.0.1:8090

# PocketBase superuser (used by scripts/migrate-pocketbase.mjs)
PB_ADMIN_EMAIL=admin@vibelabs.local
PB_ADMIN_PASSWORD=

# Initial app user (created by the migration script)
VV_USER_EMAIL=
VV_USER_PASSWORD=

# Optional: explicit cookie name (default pb_auth)
# VV_PB_COOKIE_NAME=pb_auth